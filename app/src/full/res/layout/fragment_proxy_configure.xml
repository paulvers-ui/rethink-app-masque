<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    android:fillViewport="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/settings_activity_vpn_lockdown_desc"
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:drawablePadding="10dp"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:text="@string/settings_lock_down_proxy_desc"
            android:textSize="@dimen/default_font_text_view"
            android:visibility="visible"
            app:drawableStartCompat="@drawable/dis_allowed" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/rpn_title"
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="55dp"
            android:fontFamily="sans-serif-smallcaps"
            android:lineSpacingExtra="5dp"
            android:padding="5dp"
            android:visibility="gone"
            android:text="Rethink Proxy Network (RPN)"
            android:textColor="?attr/accentGood"
            android:textSize="@dimen/extra_large_font_text_view"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/settings_activity_rpn_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/settings_activity_rpn_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="5dp"
                        android:padding="10dp"
                        android:alpha="0.5"
                        android:src="@drawable/ic_rethink_plus_sparkle" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/settings_activity_rpn_img"
                        android:layout_toEndOf="@id/settings_activity_rpn_icon"
                        android:baselineAligned="true"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/TextAppearance.AppCompat.Subhead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rethink's Proxy Network"
                            android:textSize="@dimen/large_font_text_view" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/settings_activity_rpn_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="Reimagine the way you use the internet"
                            android:textSize="@dimen/default_font_text_view" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/settings_activity_rpn_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_right_arrow_white" />

                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <RelativeLayout
            android:id="@+id/wg_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/settings_wireguard_title"
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="55dp"
                android:fontFamily="sans-serif-smallcaps"
                android:lineSpacingExtra="5dp"
                android:padding="5dp"
                android:text="@string/lbl_wireguard"
                android:textColor="?attr/accentGood"
                android:textSize="@dimen/extra_large_font_text_view"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/wg_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginEnd="20dp"
                android:padding="5dp"
                android:src="@drawable/ic_refresh_white" />

        </RelativeLayout>


<!-- WARP Tunnel Section -->
<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:id="@+id/settings_activity_warp_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/settings_activity_warp_img"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_vpn"
                android:contentDescription="WARP Icon"
                android:tint="?attr/accentGood" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/warp_tunnel_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/accentGood" />

                <TextView
                    android:id="@+id/settings_activity_warp_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/warp_status_unregistered"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Connect/disconnect switch row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:id="@+id/settings_activity_warp_switch_row">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_activity_warp_switch"
                style="@style/CustomWidget.MaterialComponents.CompoundButton.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="10dp" />

        </RelativeLayout>

        <!-- WireGuard -> WARP(SOCKS5) double hop -->
        <LinearLayout
            android:id="@+id/settings_activity_wg_s5_hop_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="wireguard - socks5 double hop"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_activity_wg_s5_hop_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="route active WireGuard tunnels through WARP (127.0.0.1:40000)"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_activity_wg_s5_hop_switch"
                style="@style/CustomWidget.MaterialComponents.CompoundButton.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp" />
        </LinearLayout>


        <!-- SNI override editor: max 20 chars, default cloudflare.com -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <com.google.android.material.textfield.TextInputLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:hint="SNI (ClientHello)">

                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/settings_activity_warp_sni_edit"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:inputType="textUri"
                      android:maxLength="20"
                      android:singleLine="true"
                      android:text="cloudflare.com" />
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/settings_activity_warp_sni_save_btn"
                  style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:text="Save"
                  android:textColor="?attr/primaryTextColor" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/settings_activity_warp_sni_reset_btn"
                  style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:text="Reset"
                  android:textColor="?attr/primaryTextColor" />
          </LinearLayout>

          <!-- config.json editor: advanced users can inspect/modify the
               WARP registration payload produced by `usque register`. Hidden
               until the device is registered. -->
          <LinearLayout
              android:id="@+id/settings_activity_warp_config_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:orientation="vertical"
              android:visibility="gone">

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="WARP config.json"
                  android:textSize="14sp"
                  android:textStyle="bold" />

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="2dp"
                  android:text="Advanced. Save restarts WARP if it is running."
                  android:textSize="11sp"
                  android:alpha="0.7" />

              <com.google.android.material.textfield.TextInputLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:hint="config.json">

                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/settings_activity_warp_config_edit"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:minLines="6"
                      android:maxLines="18"
                      android:gravity="top|start"
                      android:inputType="textMultiLine|textNoSuggestions"
                      android:fontFamily="monospace"
                      android:textSize="12sp"
                      android:scrollbars="vertical" />
              </com.google.android.material.textfield.TextInputLayout>

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:gravity="end"
                  android:orientation="horizontal">

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/settings_activity_warp_config_reload_btn"
                      style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Reload"
                      android:textColor="?attr/primaryTextColor" />

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/settings_activity_warp_config_save_btn"
                      style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:text="Save"
                      android:textColor="?attr/primaryTextColor" />
              </LinearLayout>
          </LinearLayout>

          <!-- libusque.so argument editor: shows the exact CLI args passed
               to the WARP binary and lets advanced users override them.
               {config} is replaced with the on-disk config.json path,
               {sni} with the current spoofed-SNI setting. Save restarts
               WARP if it is running. Reset restores the default template. -->
          <LinearLayout
              android:id="@+id/settings_activity_warp_args_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:orientation="vertical"
              android:visibility="gone">

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="libusque.so arguments"
                  android:textSize="14sp"
                  android:textStyle="bold" />

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="2dp"
                  android:text="Advanced. Space-separated. Use {config} for the config.json path and {sni} for the spoofed SNI. Save restarts WARP if it is running."
                  android:textSize="11sp"
                  android:alpha="0.7" />

              <com.google.android.material.textfield.TextInputLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:hint="socks -b 127.0.0.1 -p 40000 -c {config}">

                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/settings_activity_warp_args_edit"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:minLines="2"
                      android:maxLines="6"
                      android:gravity="top|start"
                      android:inputType="textMultiLine|textNoSuggestions"
                      android:autoLink="none"
                      android:linksClickable="false"
                      android:fontFamily="monospace"
                      android:textSize="12sp"
                      android:scrollbars="vertical" />
              </com.google.android.material.textfield.TextInputLayout>

              <!-- Read-only echo of the fully-substituted argv that will
                   be passed to libusque.so on next start. Updates after
                   Save / Reset / Reload so advanced users can verify their
                   edits actually landed (e.g. that the ipv6 flag is present). -->
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="Effective args (next start):"
                  android:textSize="11sp"
                  android:alpha="0.7" />

              <TextView
                  android:id="@+id/settings_activity_warp_args_effective"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="2dp"
                  android:fontFamily="monospace"
                  android:textSize="11sp"
                  android:textIsSelectable="true"
                  android:textColor="?attr/accentGood" />


              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:gravity="end"
                  android:orientation="horizontal">

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/settings_activity_warp_args_reset_btn"
                      style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Reset"
                      android:textColor="?attr/primaryTextColor" />

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/settings_activity_warp_args_reload_btn"
                      style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:text="Reload"
                      android:textColor="?attr/primaryTextColor" />

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/settings_activity_warp_args_save_btn"
                      style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:text="Save"
                      android:textColor="?attr/primaryTextColor" />
              </LinearLayout>
          </LinearLayout>

          <!-- Register button (centered, visible until registered) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_activity_warp_register_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/warp_register_button"
            android:textColor="?attr/primaryTextColor" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/settings_activity_wireguard_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/settings_activity_wireguard_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="5dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_wireguard_icon" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/settings_activity_wireguard_img"
                        android:layout_toEndOf="@id/settings_activity_wireguard_icon"
                        android:baselineAligned="true"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/TextAppearance.AppCompat.Subhead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_wireguard"
                            android:textSize="@dimen/large_font_text_view" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/settings_activity_wireguard_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="@string/wireguard_description"
                            android:textSize="@dimen/default_font_text_view" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/settings_activity_wireguard_img"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_right_arrow_white" />

                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/other_title"
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="55dp"
            android:fontFamily="sans-serif-smallcaps"
            android:lineSpacingExtra="5dp"
            android:padding="5dp"
            android:text="@string/category_name_others"
            android:textColor="?attr/accentGood"
            android:textSize="@dimen/extra_large_font_text_view"
            android:textStyle="bold" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/settings_activity_socks5_rl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/settings_activity_socks5_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="5dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_socks5" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/settings_activity_socks5_switch"
                        android:layout_toEndOf="@id/settings_activity_socks5_icon"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/TextAppearance.AppCompat.Subhead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_socks5_heading"
                            android:textSize="@dimen/large_font_text_view" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/settings_activity_socks5_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="5dp"
                            android:text="@string/settings_socks5_desc"
                            android:textSize="@dimen/default_font_text_view" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_activity_socks5_switch"
                        style="@style/CustomWidget.MaterialComponents.CompoundButton.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="10dp" />

                    <ProgressBar
                        android:id="@+id/settings_activity_socks5_progress"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:padding="10dp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/settings_activity_http_proxy_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/settings_activity_http_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="5dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_http" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/settings_activity_http_proxy_switch"
                        android:layout_toEndOf="@id/settings_activity_http_icon"
                        android:baselineAligned="true"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/TextAppearance.AppCompat.Subhead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_https_heading"
                            android:textSize="@dimen/large_font_text_view" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/settings_activity_http_proxy_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="fill"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="@string/settings_https_desc"
                            android:textSize="@dimen/default_font_text_view" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settings_activity_http_proxy_switch"
                        style="@style/CustomWidget.MaterialComponents.CompoundButton.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="10dp" />

                    <ProgressBar
                        android:id="@+id/settings_activity_http_proxy_progress"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:padding="10dp" />
                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
