<?xml version="1.0" encoding="utf-8"?>
<!-- White dot with a thin grey ring so it stays visible on light themes too. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#9E9E9E" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>
